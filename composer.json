{
  "name": "roots/app",
  "description": "ROOTS Application - Professional File Management System",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "gregwar/captcha": "^1.1",
    "php-mcp/server": "^3.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "ROOTS\\": "src/"
    },
    "classmap": [
      "db_config.php"
    ],
    "files": [
      "autoload_helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "ROOTS\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "*": true
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php -r \"echo '\\n✅ Autoloader regenerated successfully!\\n\\n';\""
    ]
  }
}
